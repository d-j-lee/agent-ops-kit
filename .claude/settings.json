{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.aok/harness/aok_harness.py\" hook session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.aok/harness/aok_harness.py\" hook prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.aok/harness/aok_harness.py\" hook post-edit",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.aok/harness/aok_harness.py\" hook pre-bash",
            "timeout": 900,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.aok/harness/aok_harness.py\" hook stop",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Edit(/.aok/**)",
      "Write(/.aok/**)",
      "Edit(/.claude/settings*.json)",
      "Write(/.claude/settings*.json)",
      "Edit(/.claude/agents/aok-reviewer.md)",
      "Write(/.claude/agents/aok-reviewer.md)"
    ]
  }
}
